[Unit]
Description=OBVFUTPORT V2 read-only dashboard
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/cloud-deploy-candidates/obv-futures-portable-v2
Environment=PYTHONUNBUFFERED=1
Environment=OBVFUTPORT_V2_ROOT=/opt/cloud-deploy-candidates/obv-futures-portable-v2
ExecStart=/opt/cloud-deploy-candidates/obv-futures-portable-v2/scripts/run_dashboard.sh
Restart=always
RestartSec=10
Nice=12
CPUQuota=10%
MemoryMax=600M
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
